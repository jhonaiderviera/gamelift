<div class="error-page">
  <div class="container">
    <div class="error-card">

      <!-- Glitch effect number -->
      <div class="error-display">
        <span class="error-code" data-text="404">404</span>
        <div class="error-scanline"></div>
      </div>

      <div class="error-content">
        <h1 class="error-title">Game Over</h1>
        <p class="error-message">The page you're looking for doesn't exist, was removed, or you took a wrong turn in the dungeon.</p>

        <div class="error-suggestions">
          <p class="error-suggestion-label">Maybe try one of these:</p>
          <div class="error-actions">
            <a href="/" class="btn btn-primary error-btn">
              <i class="fas fa-home"></i> Home
            </a>
            <a href="/games" class="btn btn-outline error-btn">
              <i class="fas fa-compass"></i> Games
            </a>
            <a href="/discover" class="btn btn-outline error-btn">
              <i class="fas fa-search"></i> Discover
            </a>
          </div>
        </div>
      </div>

      <!-- Floating game icons decoration -->
      <div class="error-decoration">
        <i class="fas fa-ghost error-float-icon" style="--delay: 0s; --x: 15%; --y: 20%;"></i>
        <i class="fas fa-gamepad error-float-icon" style="--delay: 1.5s; --x: 80%; --y: 15%;"></i>
        <i class="fas fa-skull-crossbones error-float-icon" style="--delay: 3s; --x: 70%; --y: 75%;"></i>
        <i class="fas fa-heart-broken error-float-icon" style="--delay: 0.8s; --x: 25%; --y: 80%;"></i>
        <i class="fas fa-dice-d20 error-float-icon" style="--delay: 2.2s; --x: 90%; --y: 50%;"></i>
      </div>

    </div>
  </div>
</div>
