<link rel="stylesheet" href="/stylesheets/company-profile.css">

<div class="container section" style="padding-top: 40px;">

    <a href="/studios" class="btn btn-ghost"
        style="margin-bottom: 30px; display: inline-flex; align-items: center; gap: 10px; padding: 12px 24px; border-radius: 14px; background: rgba(255,255,255,0.03); backdrop-filter: blur(10px); border: 1px solid rgba(255,255,255,0.05);">
        <i class="fas fa-arrow-left"></i> Back to Hall of Fame
    </a>

    <div class="company-hero-premium" style="background-image: url('<%= data.heroBackgroundUrl %>');">
        <div class="company-logo-premium">
            <img src="<%= data.logoUrl %>" alt="<%= data.name %> Logo">
        </div>
        <div class="company-info-premium">
            <h1>
                <%= data.name %>
            </h1>
            <p>
                <%= data.description %>
            </p>
        </div>
    </div>

    <div class="section-header" style="margin-bottom: 40px; display: flex; align-items: center; gap: 20px;">
        <h2 class="h2" style="font-size: 2.2rem; letter-spacing: -0.5px;">
            <i class="fas fa-star" style="color: var(--primary, #8b5cf6); margin-right: 10px;"></i>
            Masterpiece Collection
        </h2>
        <div
            style="height: 3px; flex: 1; background: linear-gradient(90deg, var(--primary, #8b5cf6), transparent); border-radius: 3px; opacity: 0.5;">
        </div>
    </div>

    <% if (data.developed && data.developed.length> 0) { %>
        <div class="games-grid-premium">
            <% data.developed.forEach(g=> { %>
                <a href="/games/<%= g.id %>" class="game-card-premium">
                    <div class="game-cover-premium">
                        <img src="<%= g.coverUrl %>" alt="<%= g.name %>" loading="lazy">
                    </div>
                    <div class="game-body-premium">
                        <h3 class="game-title-premium">
                            <%= g.name %>
                        </h3>
                        <span class="game-year-premium">
                            <%= g.year %>
                        </span>
                    </div>
                </a>
                <% }) %>
        </div>
        <% } else { %>
            <div
                style="text-align: center; padding: 80px; background: rgba(255,255,255,0.02); border-radius: 24px; border: 2px dashed rgba(255,255,255,0.05);">
                <h3 style="color: #fff;">No games found</h3>
            </div>
            <% } %>

</div>