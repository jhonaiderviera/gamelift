<!-- Catalogo de juegos: hero con buscador, secciones por categoria y modo busqueda -->
<link rel="stylesheet" href="/stylesheets/games.css">

<div class="container" style="padding-top: 20px; padding-bottom: 60px;">

  <section class="games-hero" style="background-image: url('https://images.igdb.com/igdb/image/upload/t_1080p/co670h.jpg');">
    <div class="hero-overlay"></div>

    <div class="hero-content">
      <span class="hero-tag">Explore the Universe</span>
      <h1 class="hero-title">Discover Your <span class="text-gradient">Next Favorite</span> Game</h1>
      <p class="hero-subtitle">
        Search through thousands of titles, discover new releases, or let fate decide.
      </p>

      <!-- Buscador con boton de busqueda y dado aleatorio -->
      <div class="hero-search-container">
        <form id="gamesSearchForm" class="search-form" autocomplete="off">
          <i class="fas fa-search search-icon"></i>
          <input
            type="text"
            id="searchInput"
            placeholder="Search for a game (e.g. Zelda)..."
            class="search-input"
            value="<%= (data.searchQuery) ? data.searchQuery : '' %>"
          >
          <div class="search-actions">
            <button type="button" id="btnSearch" class="btn-search">Search</button>
            <button type="button" id="btnRandom" class="btn-random" title="Surprise me!">
              <i class="fas fa-dice"></i>
            </button>
          </div>
        </form>
      </div>

      <div class="hero-tags">
        <span>Popular:</span>
        <span class="tag-pill">RPG</span>
        <span class="tag-pill">Action</span>
        <span class="tag-pill">Indie</span>
      </div>
    </div>
  </section>

  <!-- Modo normal: secciones de new releases, coming soon y trending -->
  <div id="normalMode">

    <%/* Seccion de nuevos lanzamientos (o categoria activa) */%>
    <% if (data.newReleases && data.newReleases.length > 0) { %>
      <section class="games-section">
        <div class="section-header">
          <h2 class="section-title"><%= data.sectionTitle || "New Releases" %></h2>
          
          <%/* Si es vista de categoria, mostrar boton 'back'; si no, 'see all' */%>
          <% if (!data.isCategoryView) { %>
            <div class="section-nav">
              <a href="/games/category/new" class="btn-see-all">See all <i class="fas fa-arrow-right"></i></a>
            </div>
          <% } else { %>
            <div class="section-nav">
              <a href="/games" class="btn-back-to-games"><i class="fas fa-arrow-left"></i> Back to Games</a>
            </div>
          <% } %>
        </div>

        <div class="games-grid">
          <%/* Cada card tiene data-attrs para las acciones JS de libreria/favoritos */%>
          <% data.newReleases.forEach(game => { %>
            <article class="game-card" data-game-id="<%= game.id %>" data-name="<%= game.name %>" data-cover="<%= game.coverUrl %>" tabindex="0">
              <a href="/games/<%= game.id %>" class="card-link-wrapper">
                
                <div class="game-card__media">
                  <img src="<%= game.coverUrl || '/images/Community.png' %>" alt="<%= game.name %>" loading="lazy">
                  
                  <div class="card-overlay-actions">
                    <button class="action-btn library" title="Add to Library">
                      <i class="fas fa-plus"></i>
                    </button>
                    <button class="action-btn favorite" title="Favorite">
                      <i class="far fa-heart"></i>
                    </button>
                  </div>

                  <% if (game.gameliftScore) { %>
                    <span class="rating-badge-float <%= game.gameliftScore >= 75 ? 'rating-good' : (game.gameliftScore >= 50 ? 'rating-mid' : 'rating-bad') %>">
                      <%= game.gameliftScore %>
                    </span>
                  <% } %>
                </div>

                <div class="game-card__body">
                  <h3 class="game-card__title"><%= game.name %></h3>
                  <p class="game-card__sub"><span class="muted"><%= game.year || '' %></span></p>
                </div>
              </a>
            </article>
          <% }) %>
        </div>
      </section>
    <% } %>

    <%/* Seccion Coming Soon: solo visible en vista general, no en categoria */%>
    <% if (!data.isCategoryView && data.upcomingGames && data.upcomingGames.length > 0) { %>
      <section class="games-section" style="margin-top: 60px;">
        <div class="section-header">
          <h2 class="section-title">Coming Soon</h2>
          <div class="section-nav">
            <a href="/games/category/upcoming" class="btn-see-all">See all <i class="fas fa-arrow-right"></i></a>
          </div>
        </div>

        <div class="games-grid">
          <% data.upcomingGames.forEach(game => { %>
            <article class="game-card" data-game-id="<%= game.id %>" data-name="<%= game.name %>" tabindex="0">
              <a href="/games/<%= game.id %>" class="card-link-wrapper">
                <div class="game-card__media">
                  <img src="<%= game.coverUrl || '/images/Community.png' %>" alt="<%= game.name %>" loading="lazy">
                  
                  <div class="card-overlay-actions">
                    <button class="action-btn library"><i class="fas fa-plus"></i></button>
                    <button class="action-btn favorite"><i class="far fa-heart"></i></button>
                  </div>
                </div>
                <div class="game-card__body">
                  <h3 class="game-card__title"><%= game.name %></h3>
                  <p class="game-card__sub" style="color: #a78bfa;">Pre-order</p>
                </div>
              </a>
            </article>
          <% }) %>
        </div>
      </section>
    <% } %>

    <%/* Seccion Trending Now: juegos populares del momento */%>
    <% if (!data.isCategoryView && data.popularGames && data.popularGames.length > 0) { %>
      <section class="games-section" style="margin-top: 60px;">
        <div class="section-header">
          <h2 class="section-title">Trending Now</h2>
          <div class="section-nav">
            <a href="/games/category/popular" class="btn-see-all">See all <i class="fas fa-arrow-right"></i></a>
          </div>
        </div>

        <div class="games-grid">
          <% data.popularGames.forEach(game => { %>
            <article class="game-card" data-game-id="<%= game.id %>" data-name="<%= game.name %>" data-cover="<%= game.coverUrl %>" tabindex="0">
              <a href="/games/<%= game.id %>" class="card-link-wrapper">
                <div class="game-card__media">
                  <img src="<%= game.coverUrl || '/images/Community.png' %>" alt="<%= game.name %>" loading="lazy">
                  
                  <div class="card-overlay-actions">
                    <button class="action-btn library"><i class="fas fa-plus"></i></button>
                    <button class="action-btn favorite"><i class="far fa-heart"></i></button>
                  </div>

                  <% if (game.gameliftScore) { %>
                    <span class="rating-badge-float <%= game.gameliftScore >= 75 ? 'rating-good' : (game.gameliftScore >= 50 ? 'rating-mid' : 'rating-bad') %>">
                      <%= game.gameliftScore %>
                    </span>
                  <% } %>
                </div>
                <div class="game-card__body">
                  <h3 class="game-card__title"><%= game.name %></h3>
                  <div class="game-card__sub">
                     <% if(game.genres && game.genres.length > 0) { %>
                       <span><%= game.genres[0].name %></span>
                     <% } %>
                  </div>
                </div>
              </a>
            </article>
          <% }) %>
        </div>
      </section>
    <% } %>

  </div>

  <!-- Modo busqueda: se muestra al buscar, con grid de resultados y estados de carga/vacio/error -->
  <div id="searchMode" class="hidden">
    <div class="section-header">
      <div style="display:flex; align-items:center; gap:14px; flex-wrap:wrap;">
        <h2 class="section-title" id="resultsTitle">Search Results</h2>
        <button id="btnClearSearch" class="btn-clear-search">
          <i class="fas fa-times"></i> Clear
        </button>
      </div>
    </div>
    
    <div id="resultsGrid" class="games-grid"></div>

    <div id="resultsLoading" class="state-container hidden">
      <div class="spinner"></div>
      <p>Searching the galaxy...</p>
    </div>
    <div id="resultsEmpty" class="state-container hidden">
      <i class="fas fa-ghost" style="font-size: 2rem; margin-bottom: 10px; opacity: 0.5;"></i>
      <p>No games found.</p>
    </div>
    <div id="resultsError" class="state-container hidden">
      <i class="fas fa-exclamation-triangle" style="font-size: 2rem; margin-bottom: 10px; color: #ef4444;"></i>
      <p>Something went wrong.</p>
    </div>
  </div>

</div>

<script src="/javascripts/games-search.js"></script>
<script src="/javascripts/games-actions.js"></script>