<link rel="stylesheet" href="/stylesheets/games.css">

<div class="container" style="padding-top: 40px; padding-bottom: 80px;">

  <div class="section-header" style="margin-bottom: 40px;">
    <div>
      <span class="hero-tag" style="margin-bottom: 10px; display:inline-block;">Fresh Content</span>
      <h1 class="h1">New <span class="text-gradient">Features</span> & Releases</h1>
      <p class="muted" style="max-width: 600px; margin-top: 10px;">
        Discover the latest titles added to our database. Rate them, review them, and add them to your collection.
      </p>
    </div>
  </div>

  <div class="games-grid">
    <% if (data.games && data.games.length > 0) { %>
      <% data.games.forEach(game => { %>
        
        <article class="game-card" tabindex="0">
          <a href="/games/<%= game.id %>" class="card-link-wrapper">
            
            <div class="game-card__media">
              <img src="<%= game.coverUrl || '/images/Community.png' %>" alt="<%= game.name %>" loading="lazy">
              
              <div class="card-overlay-actions">
                <button class="action-btn library" data-game-id="<%= game.id %>" data-name="<%= game.name %>" data-cover="<%= game.coverUrl %>" title="Add to Library">
                  <i class="fas fa-plus"></i>
                </button>
                <button class="action-btn favorite" data-game-id="<%= game.id %>" data-name="<%= game.name %>" data-cover="<%= game.coverUrl %>" title="Favorite">
                  <i class="far fa-heart"></i>
                </button>
              </div>

              <% if (game.gameliftScore) { %>
                <span class="rating-badge-float <%= game.gameliftScore >= 75 ? 'rating-good' : (game.gameliftScore >= 50 ? 'rating-mid' : 'rating-bad') %>">
                  <%= game.gameliftScore %>
                </span>
              <% } %>
            </div>

            <div class="game-card__body">
              <h3 class="game-card__title"><%= game.name %></h3>
              
              <div class="game-card__sub">
                 <span class="muted"><%= game.year || '' %></span>
                 <% if(game.genres && game.genres.length > 0) { %>
                   <span style="float: right; opacity: 0.7; font-size: 0.75rem;"><%= game.genres.split(',')[0] %></span>
                 <% } %>
              </div>
            </div>

          </a>
        </article>

      <% }) %>
    <% } else { %>
      <div class="state-container">
        <i class="fas fa-ghost" style="font-size: 2rem; margin-bottom: 15px; opacity: 0.5;"></i>
        <p>No new features found at the moment.</p>
      </div>
    <% } %>
  </div>

</div>

<script src="/javascripts/games-actions.js"></script>