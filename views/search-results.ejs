<link rel="stylesheet" href="/stylesheets/home.css">
<link rel="stylesheet" href="/stylesheets/search.css">
<section class="container" style="min-height: 75vh;">

    <div class="search-header">
        <h1 class="h1">Results for "<span class="search-query-text">
                <%= data.query %>
            </span>"</h1>
    </div>

    <% if (data.companies && data.companies.length> 0) { %>
        <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 20px;">
            <h2 class="h2" style="margin: 0;"><i class="fas fa-building" style="color: var(--primary);"></i> Studios &
                Publishers</h2>
        </div>

        <div class="company-grid">
            <% data.companies.forEach(company=> { %>
                <a href="/companies/<%= company.id %>" class="company-card">
                    <div class="company-logo-wrapper">
                        <img src="<%= company.logoUrl %>" alt="<%= company.name %> Logo" loading="lazy">
                    </div>
                    <div class="company-info">
                        <h3>
                            <%= company.name %>
                        </h3>
                        <p>Known for:<br><span>
                                <%= company.knownFor %>
                            </span></p>
                    </div>
                </a>
                <% }) %>
        </div>
        <% } %>

            <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 20px;">
                <h2 class="h2" style="margin: 0;"><i class="fas fa-gamepad" style="color: var(--primary);"></i> Games
                </h2>
            </div>

            <% if (data.games && data.games.length> 0) { %>
                <div class="grid">
                    <% data.games.forEach(g=> { %>
                        <article class="game-card">
                            <div class="game-cover">
                                <a href="/games/<%= g.id %>" style="display: block; width: 100%; height: 100%;">
                                    <img src="<%= g.coverUrl %>" alt="<%= g.name %>" loading="lazy">
                                </a>
                                <% if (g.rating) { %>
                                    <span
                                        class="score <%= g.rating >= 75 ? 'score-good' : (g.rating >= 50 ? 'score-mid' : 'score-bad') %>">
                                        <%= g.rating %>
                                    </span>
                                    <% } %>
                            </div>
                            <div class="game-body">
                                <h3 class="h3">
                                    <%= g.name %>
                                </h3>
                                <p class="count-label" style="color: #9ca3af; font-size: 0.85rem;">
                                    <%= g.year %>
                                </p>
                                <div class="game-actions" style="margin-top: 10px;">
                                    <a class="btn btn-primary btn-sm" href="/games/<%= g.id %>">Details</a>
                                </div>
                            </div>
                        </article>
                        <% }) %>
                </div>
                <% } else { %>
                    <% if (!data.companies || data.companies.length===0) { %>
                        <div class="empty-search">
                            <i class="fas fa-search-minus"></i>
                            <h3 class="h2" style="color: #fff; margin-bottom: 10px;">No results found</h3>
                            <p>We couldn't find any games or studios matching "<%= data.query %>". Try another keyword!
                            </p>
                        </div>
                        <% } else { %>
                            <p style="color: #9ca3af; font-style: italic;">No specific games found for this exact title,
                                but check out the studios above!</p>
                            <% } %>
                                <% } %>

</section>