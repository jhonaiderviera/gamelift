<!-- Barra de navegacion principal con links, notificaciones y acciones de usuario -->
<header class="site-header">
  <div class="container">
    <div class="nav">

      <a class="brand" href="/">
        <span class="brand-mark">GAMELIFT</span>
      </a>

      <button class="nav-toggle" type="button" aria-controls="navMenu" aria-expanded="false">
        <span class="nav-toggle-line"></span>
        <span class="nav-toggle-line"></span>
        <span class="nav-toggle-line"></span>
      </button>

      <%/* Links de navegacion: la clase is-active se aplica segun la pagina actual */%>
      <nav id="navMenu" class="nav-menu" aria-label="Primary navigation">
        <a class="nav-link <%= (typeof active !== 'undefined' && active === 'index') ? 'is-active' : '' %>" href="/">
          Home
        </a>

        <a class="nav-link <%= (typeof active !== 'undefined' && active === 'games') ? 'is-active' : '' %>"
          href="/games">
          Games
        </a>

        <a class="nav-link <%= (typeof active !== 'undefined' && active === 'versus') ? 'is-active' : '' %>"
          href="/versus">
          <i class="fas fa-bolt" style="color: #f59e0b; margin-right: 5px;"></i> Versus
        </a>

        <a class="nav-link <%= (typeof active !== 'undefined' && active === 'discover') ? 'is-active' : '' %>"
          href="/discover">
          <i class="fas fa-fire" style="color: #ec4899; margin-right: 5px;"></i> Discover
        </a>

        <a class="nav-link <%= (typeof active !== 'undefined' && active === 'challenges') ? 'is-active' : '' %>"
          href="/challenges">
          <i class="fas fa-trophy" style="color: #fbbf24; margin-right: 5px;"></i> Challenges
        </a>

        <a class="nav-link <%= (typeof active !== 'undefined' && active === 'features') ? 'is-active' : '' %>"
          href="/features">
          <i class="fas fa-sparkles" style="color: #a78bfa; margin-right: 5px;"></i> Features
        </a>

        <a class="nav-link <%= (typeof active !== 'undefined' && active === 'support') ? 'is-active' : '' %>"
          href="/support-developers">
          <i class="fas fa-heart" style="color: #f472b6; margin-right: 5px;"></i> Support
        </a>

        <%/* Login/Register solo visible dentro del menú hamburguesa en móvil */%>
        <% if (!locals.user) { %>
          <div class="nav-mobile-auth">
            <a class="btn btn-ghost btn-sm" href="/auth/login" style="width: 100%; justify-content: center;">
              <i class="fas fa-sign-in-alt"></i> Login
            </a>
            <a class="btn btn-primary btn-sm" href="/auth/register" style="width: 100%; justify-content: center;">
              <i class="fas fa-user-plus"></i> Register
            </a>
          </div>
        <% } %>

      </nav>

      <!-- Acciones: si logueado muestra notificaciones + avatar; si no, login/register -->
      <div class="nav-actions">

        <% if (locals.user) { %>
          <!-- Campana de notificaciones con dropdown y badge de conteo -->
          <div class="notif-wrapper">
            <button class="notif-bell" id="notifBell" title="Notifications">
              <i class="fas fa-bell"></i>
              <span class="notif-badge" id="notifBadge" style="display: none;">0</span>
            </button>
            <div class="notif-dropdown" id="notifDropdown" style="display: none;">
              <div class="notif-header">
                <span>Notifications</span>
                <button id="notifReadAll">Mark all as read</button>
              </div>
              <div class="notif-list" id="notifList"></div>
            </div>
          </div>

          <a href="/profile" class="btn btn-ghost btn-sm"
            style="display: flex; align-items: center; gap: 10px; padding: 6px 12px; border-radius: 50px;">
            <img
              src="<%= (user.avatarUrl) ? user.avatarUrl : 'https://ui-avatars.com/api/?background=random&color=fff&name=' + (user.username || 'User') %>"
              alt="<%= user.username || 'User' %>"
              style="width: 28px; height: 28px; border-radius: 50%; object-fit: cover;">

            <span style="font-weight: 600;">
              <%= user.username || 'Profile' %>
            </span>
          </a>

          <% } else { %>

            <div class="nav-auth">
              <a class="btn btn-ghost btn-sm" href="/auth/login">Login</a>
              <a class="btn btn-primary btn-sm" href="/auth/register">Register</a>
            </div>

            <% } %>

      </div>

    </div>
  </div>
</header>