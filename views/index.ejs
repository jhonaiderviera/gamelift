<link rel="stylesheet" href="/stylesheets/home.css">

<section class="container section">
  <div class="hero-frame" data-carousel tabindex="0" aria-label="Featured games carousel">
    <div class="hero-track" data-carousel-track>
      <% (data.heroSlides || []).forEach((s, idx) => { %>
        <article class="hero-slide" data-carousel-slide aria-hidden="<%= idx === 0 ? 'false' : 'true' %>">
          <div class="hero-bg" style="background-image:url('<%= s.imageUrl %>')"></div>
          <div class="hero-overlay"></div>
          <div class="hero-content">
            <div class="hero-info">
              <div class="hero-subtitle"><span class="hero-chip">Trending Now</span><span><%= s.subtitle || 'Featured' %></span></div>
              <h2 class="hero-title"><%= s.title %></h2>
              <div class="hero-actions">
                <a class="btn btn-primary" href="<%= s.ctaHref %>">View Details</a>
                <button class="btn btn-ghost" title="Add to Wishlist">
                   <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg> Wishlist
                </button>
              </div>
            </div>
            <div class="hero-scores">
              <div class="score-card gamelift">
                <div class="score-ring"><span class="score-value"><%= s.gameliftRating || '—' %></span></div>
                <div class="score-label"><span class="label-main">GameLift</span><span class="label-sub">Score</span></div>
              </div>
              <div class="score-divider"></div>
              <div class="score-card global">
                <div class="score-ring"><span class="score-value"><%= s.globalRating || '—' %></span></div>
                <div class="score-label"><span class="label-main">Global</span><span class="label-sub">Rating</span></div>
              </div>
            </div>
          </div>
        </article>
      <% }) %>
    </div>
    <button class="hero-arrow hero-arrow--left" type="button" data-carousel-prev><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M15 18l-6-6 6-6"/></svg></button>
    <button class="hero-arrow hero-arrow--right" type="button" data-carousel-next><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9 18l6-6-6-6"/></svg></button>
    <div class="hero-dots" data-carousel-dots>
      <% (data.heroSlides || []).forEach((s, idx) => { %>
        <button class="hero-dot <%= idx === 0 ? 'is-active' : '' %>" type="button" data-carousel-dot="<%= idx %>"></button>
      <% }) %>
    </div>
  </div>
</section>

<section class="section container">
  <div class="section-head">
    <h2 class="h2">Top Rated Games</h2>
    <p class="muted">Curated list of the highest rated games by the community this month.</p>
  </div>
  <div class="grid">
    <% (data.topGames || []).slice(0, 9).forEach(g => { %>
      <article class="game-card">
        <div class="game-cover">
          <img src="<%= g.coverUrl || '/images/Community.png' %>" alt="<%= g.name %> cover" loading="lazy">
          <span class="score score-good">95</span>
        </div>
        <div class="game-body">
          <h3 class="h3"><%= g.name %></h3>
          <p class="game-desc"><%= (g.summary || "No description available.").slice(0, 100) %>...</p>
          <div class="game-actions">
            <a class="btn btn-primary btn-sm" href="/games/<%= g.id %>">Details</a>
            <button class="btn btn-ghost btn-sm">Quick View</button>
          </div>
        </div>
      </article>
    <% }) %>
  </div>
</section>

<section class="container" style="margin-top: 60px; margin-bottom: 60px;">
  <div class="section-header" style="display:flex; align-items:center; gap:10px; margin-bottom:20px;">
    <h2 class="h2"><i class="fas fa-bolt" style="color:#f59e0b;"></i> Community Pulse</h2>
  </div>

  <div class="activity-feed-grid">
    <% if (data.activities && data.activities.length > 0) { %>
      <% data.activities.forEach(act => { %>
        <div class="activity-card">
          <div class="act-icon <%= act.type %>">
            <% if(act.type == 'review') { %><i class="fas fa-star"></i><% } %>
            <% if(act.type == 'donate') { %><i class="fas fa-heart"></i><% } %>
            <% if(act.type == 'follow') { %><i class="fas fa-user-plus"></i><% } %>
            <% if(act.type == 'devlog') { %><i class="fas fa-bullhorn"></i><% } %>
          </div>
          <div class="act-content">
            <div class="act-header">
              <a href="/profile/u/<%= act.userId %>" class="user-link">
                <img src="<%= act.userAvatar %>" alt="Avatar">
                <span><%= act.username %></span>
              </a>
              <span class="act-time"><%= act.timeAgo %></span>
            </div>
            <p class="act-text">
              <% if(act.type == 'review') { %>
                reviewed <strong><%= act.targetName %></strong> with a score of <span class="score-mini"><%= act.extraData.score %></span>
              <% } else if (act.type == 'donate') { %>
                donated <strong>$<%= act.extraData.amount %></strong> to <a href="/support-developers/<%= act.targetId %>"><%= act.targetName %></a>
              <% } else if (act.type == 'follow') { %>
                started following <a href="/profile/u/<%= act.targetId %>"><%= act.targetName %></a>
              <% } else if (act.type == 'devlog') { %>
                posted an update on <strong><%= act.targetName %></strong>: "<%= act.extraData.title %>"
              <% } %>
            </p>
          </div>
        </div>
      <% }) %>
    <% } else { %>
      <div class="empty-feed">No activity yet. Be the first!</div>
    <% } %>
  </div>
</section>

<style>
  .activity-feed-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 15px; }
  .activity-card { background: #1f2937; border: 1px solid #374151; border-radius: 12px; padding: 15px; display: flex; gap: 15px; align-items: flex-start; transition: 0.2s; }
  .activity-card:hover { transform: translateY(-2px); border-color: #4b5563; }
  .act-icon { width: 36px; height: 36px; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-size: 0.9rem; }
  .act-icon.review { background: rgba(139, 92, 246, 0.2); color: #a78bfa; }
  .act-icon.donate { background: rgba(236, 72, 153, 0.2); color: #f472b6; }
  .act-icon.follow { background: rgba(59, 130, 246, 0.2); color: #60a5fa; }
  .act-icon.devlog { background: rgba(16, 185, 129, 0.2); color: #34d399; }
  .act-header { display: flex; justify-content: space-between; font-size: 0.85rem; margin-bottom: 5px; }
  .user-link { display: flex; align-items: center; gap: 8px; color: #fff; text-decoration: none; font-weight: 600; }
  .user-link img { width: 24px; height: 24px; border-radius: 50%; }
  .act-time { color: #6b7280; font-size: 0.75rem; }
  .act-text { margin: 0; color: #d1d5db; font-size: 0.9rem; line-height: 1.4; }
  .act-text a { color: #60a5fa; text-decoration: none; }
  .act-text a:hover { text-decoration: underline; }
  .score-mini { background: #374151; padding: 1px 6px; border-radius: 4px; font-weight: 700; font-size: 0.8rem; }
  .empty-feed { grid-column: 1 / -1; text-align: center; padding: 40px; color: #6b7280; border: 2px dashed #374151; border-radius: 12px; }
</style>

<script src="/javascripts/hero-slider.js" defer></script>