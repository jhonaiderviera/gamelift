<link rel="stylesheet" href="/stylesheets/home.css">

<section class="container section">
  <div class="hero-frame" data-carousel tabindex="0" aria-label="Featured games carousel">
    <div class="hero-track" data-carousel-track>

      <% (data.heroSlides || []).forEach((s, idx) => { %>
        <article
          class="hero-slide"
          data-carousel-slide
          aria-hidden="<%= idx === 0 ? 'false' : 'true' %>"
        >
          <div class="hero-bg" style="background-image:url('<%= s.imageUrl %>')"></div>
          <div class="hero-overlay"></div>

          <div class="hero-content">
            
            <div class="hero-info">
              <div class="hero-subtitle">
                <span class="hero-chip">Trending Now</span>
                <span><%= s.subtitle || 'Featured' %></span>
              </div>
              <h2 class="hero-title"><%= s.title %></h2>

              <div class="hero-actions">
                <a class="btn btn-primary" href="<%= s.ctaHref %>">View Details</a>
                <button class="btn btn-ghost" title="Add to Wishlist">
                   <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 6px;">
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                  </svg>
                  Wishlist
                </button>
              </div>
            </div>

            <div class="hero-scores">
              
              <div class="score-card gamelift">
                <div class="score-ring">
                  <span class="score-value"><%= s.gameliftRating || '—' %></span>
                </div>
                <div class="score-label">
                  <span class="label-main">GameLift</span>
                  <span class="label-sub">Score</span>
                </div>
              </div>

              <div class="score-divider"></div>

              <div class="score-card global">
                <div class="score-ring">
                  <span class="score-value"><%= s.globalRating || '—' %></span>
                </div>
                <div class="score-label">
                  <span class="label-main">Global</span>
                  <span class="label-sub">Rating</span>
                </div>
              </div>

            </div>

          </div>
        </article>
      <% }) %>

    </div>

    <button class="hero-arrow hero-arrow--left" type="button" data-carousel-prev aria-label="Previous slide">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M15 18l-6-6 6-6"/>
      </svg>
    </button>
    <button class="hero-arrow hero-arrow--right" type="button" data-carousel-next aria-label="Next slide">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M9 18l6-6-6-6"/>
      </svg>
    </button>

    <div class="hero-dots" data-carousel-dots>
      <% (data.heroSlides || []).forEach((s, idx) => { %>
        <button
          class="hero-dot <%= idx === 0 ? 'is-active' : '' %>"
          type="button"
          data-carousel-dot="<%= idx %>"
          aria-label="Go to slide <%= idx + 1 %>"
        ></button>
      <% }) %>
    </div>
  </div>
</section>

<section class="section container">
  <div class="section-head">
    <h2 class="h2">Top Rated Games</h2>
    <p class="muted">Curated list of the highest rated games by the community this month.</p>
  </div>

  <div class="grid">
    <% (data.topGames || []).slice(0, 9).forEach(g => { %>
      <article class="game-card">
        <div class="game-cover">
          <img src="<%= g.coverUrl || '/images/Community.png' %>" alt="<%= g.name %> cover" loading="lazy">
          <span class="score score-good">95</span>
        </div>
        <div class="game-body">
          <h3 class="h3"><%= g.name %></h3>
          <p class="game-desc"><%= (g.summary || "No description available.").slice(0, 100) %>...</p>
          <div class="game-actions">
            <a class="btn btn-primary btn-sm" href="/games/<%= g.id %>">Details</a>
            <button class="btn btn-ghost btn-sm">Quick View</button>
          </div>
        </div>
      </article>
    <% }) %>
  </div>
</section>

<script src="/javascripts/hero-slider.js" defer></script>