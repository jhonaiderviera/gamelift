<!-- Pagina de inicio: hero slider, top games globales/locales, versus y community pulse -->
<link rel="stylesheet" href="/stylesheets/home.css">

<%/* Precargar imagenes del hero para que el navegador las descargue de inmediato */%>
<% (data.heroSlides || []).forEach((s, idx) => { %>
  <link rel="preload" as="image" href="<%= s.imageUrl %>" <% if (idx === 0) { %>fetchpriority="high"<% } %>>
<% }) %>

<!-- Hero slider: carrusel de juegos destacados con puntuaciones GameLift y Global -->
<section class="container section">
  <div class="hero-frame" data-carousel tabindex="0" aria-label="Featured games carousel">
    <div class="hero-track" data-carousel-track>
      <%/* Recorrer cada slide del hero con su imagen, titulo y scores */%>
      <% (data.heroSlides || []).forEach((s, idx)=> { %>
        <article class="hero-slide" data-carousel-slide aria-hidden="<%= idx === 0 ? 'false' : 'true' %>">
          <div class="hero-bg" style="background-image:url('<%= s.imageUrl %>')"></div>
          <div class="hero-overlay"></div>
          <div class="hero-content">
            <div class="hero-info">
              <div class="hero-subtitle"><span class="hero-chip">Trending</span><span>
                  <%= s.subtitle %>
                </span></div>
              <h2 class="hero-title">
                <%= s.title %>
              </h2>
              <div class="hero-actions">
                <a class="btn btn-primary" href="<%= s.ctaHref %>">View Details</a>
              </div>
            </div>

            <!-- Puntuaciones: GameLift (comunidad) vs Global (critica) -->
            <div class="hero-scores">
              <div class="score-card gamelift">
                <div
                  class="score-ring <%= s.gameliftRating ? (s.gameliftRating>=75?'good':s.gameliftRating>=50?'mid':'bad') : 'none' %>">
                  <span class="score-value" style="<%= !s.gameliftRating ? 'font-size:1rem;' : '' %>">
                    <%= s.gameliftRating || 'N/A' %>
                  </span>
                </div>
                <div class="score-label">
                  <span class="label-main">GameLift</span>
                  <span class="label-sub">
                    <%= s.reviewCount> 0 ? `${s.reviewCount} reviews` : 'No reviews' %>
                  </span>
                </div>
              </div>

              <div class="score-divider"></div>

              <div class="score-card global">
                <div
                  class="score-ring <%= s.globalRating ? (s.globalRating>=75?'good':s.globalRating>=50?'mid':'bad') : 'none' %>">
                  <span class="score-value">
                    <%= s.globalRating || '—' %>
                  </span>
                </div>
                <div class="score-label"><span class="label-main">Global</span><span class="label-sub">Critic
                    Rating</span></div>
              </div>
            </div>

          </div>
        </article>
        <% }) %>
    </div>
    <button class="hero-arrow hero-arrow--left" type="button" data-carousel-prev><svg width="24" height="24"
        viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <path d="M15 18l-6-6 6-6" />
      </svg></button>
    <button class="hero-arrow hero-arrow--right" type="button" data-carousel-next><svg width="24" height="24"
        viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <path d="M9 18l6-6-6-6" />
      </svg></button>
    <div class="hero-dots" data-carousel-dots>
      <% (data.heroSlides || []).forEach((s, idx)=> { %>
        <button class="hero-dot <%= idx === 0 ? 'is-active' : '' %>" type="button"
          data-carousel-dot="<%= idx %>"></button>
        <% }) %>
    </div>
  </div>
</section>

<!-- Seccion Global Legends: top juegos segun IGDB/Metacritic -->
<section class="container section">
  <div class="section-head" style="margin-bottom: 20px;">
    <div style="display:flex; align-items:center; gap:10px;">
      <h2 class="h2">Global Legends</h2>
      <span class="badge-source global">IGDB / Metacritic</span>
    </div>
    <p class="muted">Critically acclaimed games worldwide.</p>
  </div>

  <div class="grid">
    <%/* Recorrer los juegos top globales ordenados por rating de critica */%>
    <% if(data.globalTop && data.globalTop.length> 0) { %>
      <% data.globalTop.forEach(g=> { %>
        <article class="game-card">
          <div class="game-cover">
            <a href="/games/<%= g.id %>" style="display: block; width: 100%; height: 100%;">
              <img src="<%= g.coverUrl %>" alt="<%= g.name %>" fetchpriority="high">
            </a>
            <span class="score score-good">
              <%= Math.round(g.rating) %>
            </span>
          </div>
          <div class="game-body">
            <h3 class="h3">
              <%= g.name %>
            </h3>
            <div class="game-actions">
              <a class="btn btn-primary btn-sm" href="/games/<%= g.id %>">Details</a>
            </div>
          </div>
        </article>
        <% }) %>
          <% } else { %>
            <p class="muted">Loading global stats...</p>
            <% } %>
  </div>
</section>

<!-- Seccion Community Favorites: mejores juegos segun la comunidad de GameLift -->
<section class="container section"
  style="background: rgba(139, 92, 246, 0.05); padding: 30px; border-radius: 20px; border: 1px solid rgba(139, 92, 246, 0.2);">
  <div class="section-head" style="margin-bottom: 20px;">
    <div style="display:flex; align-items:center; gap:10px;">
      <h2 class="h2" style="color: #a78bfa;">Community Favorites</h2>
      <span class="badge-source local">GameLift Users</span>
    </div>
    <p class="muted">The highest rated games by our own community.</p>
  </div>

  <div class="grid">
    <% if(data.localTop && data.localTop.length> 0) { %>
      <% data.localTop.forEach(g=> { %>
        <article class="game-card local-card">
          <div class="game-cover">
            <a href="/games/<%= g.id %>" style="display: block; width: 100%; height: 100%;">
              <img src="<%= g.coverUrl %>" alt="<%= g.name %>" loading="lazy">
            </a>
            <span class="score score-local">
              <%= g.rating %>
            </span>
          </div>
          <div class="game-body">
            <h3 class="h3">
              <%= g.name %>
            </h3>
            <p class="count-label"><i class="fas fa-user"></i>
              <%= g.count %> reviews
            </p>
            <div class="game-actions">
              <a class="btn btn-ghost btn-sm" href="/games/<%= g.id %>">Check Reviews</a>
            </div>
          </div>
        </article>
        <% }) %>
          <% } else { %>
            <div class="empty-state-mini">
              <i class="fas fa-comment-slash"></i>
              <p>No community favorites yet. Start reviewing games!</p>
            </div>
            <% } %>
  </div>
</section>

<!-- Seccion Versus Arena: batalla diaria en vivo + historial de batallas pasadas -->
<section class="container section-margin" style="margin-bottom: 80px;">

  <div class="section-header" style="display: flex; align-items: center; gap: 15px; margin-bottom: 25px;">
    <h2 class="h2">Versus Arena</h2>
    <div style="height: 2px; flex: 1; background: linear-gradient(90deg, #374151, transparent);"></div>
  </div>

  <%/* Si hay batalla del dia, mostrar la tarjeta de batalla en vivo */%>
  <% if (data.todaysBattle) { %>
    <div class="live-battle-card">
      <div class="live-badge"><span class="pulse-dot"></span> LIVE NOW</div>

      <div class="live-content">
        <div class="live-fighter">
          <a href="/games/<%= data.todaysBattle.game1.id %>" style="display: block; line-height: 0;">
            <img src="<%= data.todaysBattle.game1.coverUrl %>" class="live-cover" alt="Team Red">
          </a>
          <div class="live-info">
            <span class="team-name red">Team Red</span>
            <h4>
              <%= data.todaysBattle.game1.name %>
            </h4>
            <span class="vote-count">
              <%= data.todaysBattle.p1 %>%
            </span>
          </div>
        </div>

        <div class="live-center">
          <div class="vs-circle">VS</div>
          <div class="live-bar-track">
            <div class="live-bar-fill" style="width: <%= data.todaysBattle.p1 %>%"></div>
          </div>
          <a href="/versus" class="btn btn-vote-now">Vote Now</a>
        </div>

        <div class="live-fighter right">
          <div class="live-info right-align">
            <span class="team-name blue">Team Blue</span>
            <h4>
              <%= data.todaysBattle.game2.name %>
            </h4>
            <span class="vote-count">
              <%= data.todaysBattle.p2 %>%
            </span>
          </div>
          <a href="/games/<%= data.todaysBattle.game2.id %>" style="display: block; line-height: 0;">
            <img src="<%= data.todaysBattle.game2.coverUrl %>" class="live-cover" alt="Team Blue">
          </a>
        </div>
      </div>
    </div>
    <% } %>

      <div
        style="display: flex; align-items: center; justify-content: space-between; margin-top: 50px; margin-bottom: 20px;">
        <div style="display:flex; align-items:center; gap:10px;">
          <h3 class="h2" style="margin: 0;">Hall of Legends</h3>
        </div>
        <a href="/versus" class="btn btn-ghost btn-sm"
          style="font-size: 0.8rem; padding: 6px 12px; border: 1px solid rgba(255,255,255,0.1); background: #111827;">
          Play Today's Battle <i class="fas fa-bolt" style="color: #f59e0b; margin-left: 5px;"></i>
        </a>
      </div>

      <%/* Hall of Legends: historial de batallas pasadas con ganadores */%>
      <% if (data.versusHistory && data.versusHistory.length> 0) { %>
        <div class="hall-grid">
          <% data.versusHistory.forEach(battle=> { %>
            <a href="/versus/<%= battle.date %>" class="hall-card <%= battle.winnerColor %>-win">
              <div class="hall-date">
                <%= battle.date %>
              </div>
              <div class="hall-content">
                <div class="winner-info">
                  <img
                    src="<%= battle.winner.coverUrl ? battle.winner.coverUrl.replace('t_cover_big', 't_thumb') : '/images/no-cover.png' %>"
                    class="winner-cover" loading="lazy">
                  <span class="crown-icon"><i class="fas fa-crown"></i></span>
                </div>
                <div class="battle-details">
                  <h4>
                    <%= battle.winner.name %>
                  </h4>
                  <p class="defeated">Defeated <%= (battle.winner.id===battle.game1.id) ? battle.game2.name :
                      battle.game1.name %>
                  </p>
                  <%/* Calcular porcentajes de votos para la barra de progreso */%>
                  <% const total=(battle.game1.votes || 0) + (battle.game2.votes || 0); const p1=total===0 ? 50 :
                    Math.round((battle.game1.votes/total)*100); %>
                    <div class="mini-bar-track">
                      <div class="mini-bar-fill" style="width: <%= p1 %>%;"></div>
                    </div>
                </div>
              </div>
            </a>
            <% }) %>
        </div>
        <% } else { %>
          <div
            style="border: 1px dashed rgba(255,255,255,0.15); border-radius: 12px; padding: 50px 20px; text-align: center; background: rgba(17, 24, 39, 0.5); backdrop-filter: blur(10px);">
            <p style="color: #9ca3af; margin-bottom: 20px; font-size: 0.95rem;">No battles recorded yet. Be the first to
              vote today!</p>
            <a href="/versus" class="btn btn-primary"
              style="padding: 10px 24px; font-weight: 600; box-shadow: 0 5px 15px rgba(139, 92, 246, 0.3);">Go to
              Arena</a>
          </div>
          <% } %>
</section>

<!-- Community Pulse: feed de actividad social (reviews, follows, donaciones, etc.) -->
<section class="container" style="margin-top: 60px; margin-bottom: 60px;">
  <div class="section-header" style="display:flex; align-items:center; justify-content:space-between; margin-bottom:24px;">
    <div style="display:flex; align-items:center; gap:10px;">
      <h2 class="h2"><i class="fas fa-bolt" style="color:#f59e0b;"></i> Community Pulse</h2>
      <%/* Badge indica si el feed es de 'following' o 'global' */%>
      <% if (data.activityMode === 'following') { %>
        <span class="pulse-badge following"><i class="fas fa-users"></i> Following</span>
      <% } else { %>
        <span class="pulse-badge global"><i class="fas fa-globe"></i> Global</span>
      <% } %>
    </div>
  </div>

  <div class="activity-feed-grid" id="activityFeed">
    <% if (data.activities && data.activities.length > 0) { %>
      <%/* Recorrer actividades: las primeras 4 visibles, el resto ocultas */%>
      <% data.activities.forEach((act, idx) => { %>
        <div class="activity-card<%= idx >= 4 ? ' activity-hidden' : '' %>">
          <%/* Icono cambia segun tipo: review, donate, follow, devlog, collection, comment */%>
          <div class="act-icon <%= act.type %>">
            <% if (act.type === 'review') { %><i class="fas fa-star"></i>
            <% } else if (act.type === 'donate') { %><i class="fas fa-heart"></i>
            <% } else if (act.type === 'follow') { %><i class="fas fa-user-plus"></i>
            <% } else if (act.type === 'devlog') { %><i class="fas fa-bullhorn"></i>
            <% } else if (act.type === 'collection') { %><i class="fas fa-layer-group"></i>
            <% } else if (act.type === 'comment') { %><i class="fas fa-comment"></i>
            <% } %>
          </div>
          <div class="act-content">
            <div class="act-header">
              <a href="/profile/u/<%= act.userId || act.uid || act.authorId || act.id %>" class="user-link">
                <img
                  src="<%= (act.userAvatar && act.userAvatar.startsWith('http')) ? act.userAvatar : 'https://ui-avatars.com/api/?name=' + (act.username || 'U') + '&background=random&color=fff&size=64' %>"
                  alt="<%= act.username %>"
                  onerror="this.src='https://ui-avatars.com/api/?name=<%= (act.username || 'U').charAt(0) %>&background=6b7280&color=fff&size=64'"
                >
                <span><%= act.username %></span>
              </a>
              <span class="act-time"><%= act.timeAgo %></span>
            </div>
            <%/* Texto de actividad: diferente segun el tipo de accion del usuario */%>
            <p class="act-text">
              <% if (act.type === 'review') { %>
                reviewed <strong><a href="/games/<%= act.targetId %>#review-<%= act.targetId %>_<%= act.userId %>" class="act-link"><%= act.targetName %></a></strong>
                with a score of <span class="score-mini"><%= act.extraData?.score %></span>
              <% } else if (act.type === 'donate') { %>
                donated <strong>$<%= act.extraData?.amount %></strong> to
                <a href="/support-developers/<%= act.targetId %>" class="act-link"><%= act.targetName %></a>
              <% } else if (act.type === 'follow') { %>
                started following <a href="/profile/u/<%= act.targetId %>" class="act-link"><%= act.targetName %></a>
              <% } else if (act.type === 'devlog') { %>
                posted an update on <strong><%= act.targetName %></strong>: "<%= act.extraData?.title %>"
              <% } else if (act.type === 'collection') { %>
                created a new collection <strong><a href="/collections/<%= act.targetId %>" class="act-link"><%= act.targetName %></a></strong>
              <% } else if (act.type === 'comment') { %>
                commented on a review of <strong><a href="/games/<%= act.targetId %><%= act.extraData?.reviewId ? '#review-' + act.extraData.reviewId : '' %>" class="act-link"><%= act.targetName %></a></strong>
                <% if (act.extraData?.commentPreview) { %>
                  — "<span style="color: var(--muted-mid, #9ca3af); font-style: italic;"><%= act.extraData.commentPreview %><%= act.extraData.commentPreview.length >= 60 ? '...' : '' %></span>"
                <% } %>
              <% } %>
            </p>
          </div>
        </div>
      <% }) %>
    <% } else { %>
      <div class="empty-feed">
        <i class="fas fa-satellite-dish" style="font-size: 2rem; margin-bottom: 12px; opacity: 0.4;"></i>
        <% if (data.activityMode === 'following') { %>
          <p>No recent activity from people you follow.</p>
          <a href="/games" class="empty-feed-link">Discover games & connect with players</a>
        <% } else if (locals.user) { %>
          <p>No activity yet. Follow other players to see their updates here!</p>
          <a href="/games" class="empty-feed-link">Explore the catalog</a>
        <% } else { %>
          <p>No activity yet. Sign in and follow players to build your feed!</p>
          <a href="/auth/login" class="empty-feed-link">Log in to get started</a>
        <% } %>
      </div>
    <% } %>
  </div>

  <% if (data.activities && data.activities.length > 4) { %>
    <div class="pulse-toggle-wrap">
      <button class="pulse-toggle-btn" id="pulseToggle" onclick="togglePulse()">
        <span id="pulseToggleText">Show all (<%= data.activities.length - 4 %> more)</span>
        <i class="fas fa-chevron-down" id="pulseToggleIcon"></i>
      </button>
    </div>
  <% } %>
</section>

<!-- Script para expandir/colapsar el feed de actividad -->
<script>
function togglePulse() {
  const feed = document.getElementById('activityFeed');
  const btn = document.getElementById('pulseToggle');
  const text = document.getElementById('pulseToggleText');
  const icon = document.getElementById('pulseToggleIcon');
  const hidden = feed.querySelectorAll('.activity-hidden');
  const visible = feed.querySelectorAll('.activity-card:not(.activity-hidden)');
  const isExpanded = btn.classList.contains('expanded');

  if (isExpanded) {
    feed.querySelectorAll('.activity-card').forEach((card, i) => {
      if (i >= 4) card.classList.add('activity-hidden');
    });
    btn.classList.remove('expanded');
    text.textContent = 'Show all (' + (feed.querySelectorAll('.activity-card').length - 4) + ' more)';
    icon.style.transform = 'rotate(0deg)';
    feed.scrollIntoView({ behavior: 'smooth', block: 'start' });
  } else {
    feed.querySelectorAll('.activity-hidden').forEach(card => {
      card.classList.remove('activity-hidden');
    });
    btn.classList.add('expanded');
    text.textContent = 'Show less';
    icon.style.transform = 'rotate(180deg)';
  }
}
</script>
