<%/* Mapa de plataformas: asocia IDs de IGDB con iconos de Font Awesome */%>
<% const platformMap={ 6: { icon: 'fab fa-windows' , name: 'PC (Windows)' }, 14: { icon: 'fab fa-apple' , name: 'Mac' },
  3: { icon: 'fab fa-linux' , name: 'Linux' }, 48: { icon: 'fab fa-playstation' , name: 'PS4' }, 167:{
  icon: 'fab fa-playstation' , name: 'PS5' }, 9: { icon: 'fab fa-playstation' , name: 'PS3' }, 49: { icon: 'fab fa-xbox'
  , name: 'Xbox One' }, 169:{ icon: 'fab fa-xbox' , name: 'Xbox Series' }, 12: { icon: 'fab fa-xbox' , name: 'Xbox 360'
  }, 130:{ icon: 'fas fa-gamepad' , name: 'Nintendo Switch' }, 34: { icon: 'fab fa-android' , name: 'Android' }, 39: {
  icon: 'fab fa-app-store-ios' , name: 'iOS' } }; %>

  <!-- Pagina detalle del juego: hero, info, reviews, sidebar y modales -->
  <div class="detail-page">

    <!-- Hero con fondo backdrop y datos principales del juego -->
    <div class="detail-hero">
      <div class="detail-hero__bg" style="background-image: url('<%= data.backdropUrl || data.coverUrl %>');"></div>
      <div class="detail-hero__overlay"></div>

      <div class="container detail-hero__content">
        <div class="detail-header" data-game-id="<%= data.id %>" data-name="<%= data.name %>"
          data-cover="<%= data.coverUrl %>">

          <div class="detail-cover">
            <img src="<%= data.coverUrl || '/images/no-cover.svg' %>" alt="<%= data.name %> Cover">
          </div>

          <div class="detail-info">
            <h1 class="detail-title">
              <%= data.name %>
            </h1>
            <div class="detail-meta">
              <span class="detail-date">
                <%= data.year %>
              </span>
              <span class="separator">•</span>
              <span>
                <%= data.companies ? data.companies.split(',')[0] : 'Unknown Dev' %>
              </span>
            </div>
            <div class="detail-genres">
              <% if (data.genres) { %>
                <% data.genres.split(', ').forEach(genre => { %>
                <span class="detail-tag"><%= genre %></span>
              <% }) %>
            <% } %>
          </div>
          
          <!-- Acciones: agregar a libreria, favoritos y colecciones -->
          <div class="detail-actions">

             <%/* Si ya esta en la libreria, mostrar selector de estado; si no, boton de agregar */%>
             <div class="status-selector-wrapper" style="position: relative; display: inline-block;">
                <% if (data.libraryStatus) { %>
                  <select id="gameStatusSelect" onchange="updateGameStatus(this.value)" class="btn btn-primary" 
                          style="padding-right: 35px; appearance: none; cursor: pointer; background-color: var(--primary); text-align: left; min-width: 140px;">
                    <option value="backlog" <%= data.libraryStatus === ' backlog' ? 'selected' : '' %>>📚 Backlog
                  </option>
                  <option value="playing" <%=data.libraryStatus==='playing' ? 'selected' : '' %>>🎮 Playing</option>
                  <option value="completed" <%=data.libraryStatus==='completed' ? 'selected' : '' %>>🏆 Completed
                  </option>
                  <option value="on-hold" <%=data.libraryStatus==='on-hold' ? 'selected' : '' %>>⏸️ On Hold</option>
                  <option value="dropped" <%=data.libraryStatus==='dropped' ? 'selected' : '' %>>💀 Dropped</option>
                  </select>
                  <i class="fas fa-chevron-down"
                    style="position: absolute; right: 15px; top: 50%; transform: translateY(-50%); pointer-events: none; font-size: 0.8rem;"></i>
                  <% } else { %>
                    <button class="btn btn-primary" onclick="addToLibraryInitial()">
                      <i class="fas fa-plus"></i> Add to Library
                    </button>
                    <% } %>
            </div>

            <button class="btn btn-ghost js-manage-favorite" onclick="toggleFavorite()">
              <i class="far fa-heart"></i> Favorite
            </button>

            <button class="btn btn-ghost" type="button" onclick="openCollectionModal()">
              <i class="fas fa-list"></i> Add to List
            </button>
          </div>
        </div>

        <!-- Puntuaciones: GameLift (comunidad) y Global (critica) con colores dinamicos -->
        <div class="detail-scores">
          <div class="score-box gamelift">
            <div
              class="score-circle <%= data.gameliftScore ? ((data.gameliftScore >= 75) ? 'good' : ((data.gameliftScore >= 50) ? 'mid' : 'bad')) : 'mid' %>">
              <%= data.gameliftScore || '—' %>
            </div>
            <div class="score-meta">
              <span class="score-label main">GameLift</span>
              <span class="score-label sub">
                <%= data.reviewCount> 0 ? `Based on ${data.reviewCount} ratings` : 'No ratings yet' %>
              </span>
            </div>
          </div>
          <div class="score-divider"></div>
          <div class="score-box global">
            <div class="score-circle <%= (data.rating >= 75) ? 'good' : ((data.rating >= 50) ? 'mid' : 'bad') %>">
              <%= data.rating ? Math.round(data.rating) : '—' %>
            </div>
            <div class="score-meta"><span class="score-label main">Global</span><span class="score-label sub">Critic
                Score</span></div>
          </div>
        </div>

      </div>
    </div>
  </div>

  <div class="container detail-body">
    <div class="detail-main">

      <section>
        <h3 class="section-title">About</h3>
        <p class="detail-summary">
          <%= data.summary %>
        </p>
        <% if (data.storyline) { %>
          <div
            style="margin-top: 20px; font-style: italic; color: var(--muted); border-left: 3px solid var(--primary); padding-left: 15px;">
            <p>"<%= data.storyline %>"</p>
          </div>
          <% } %>
      </section>

      <%/* Trailer de YouTube (si existe) */%>
      <% if (data.videos && data.videos.length> 0) { %>
        <section style="margin-top: 40px;">
          <h3 class="section-title">Trailer</h3>
          <div class="video-wrapper">
            <iframe src="https://www.youtube.com/embed/<%= data.videos[0].video_id %>" frameborder="0"
              allowfullscreen></iframe>
          </div>
        </section>
        <% } %>

          <% if (data.screenshots && data.screenshots.length> 0) { %>
            <section style="margin-top: 40px;">
              <h3 class="section-title">Gallery</h3>
              <div class="detail-gallery">
                <% data.screenshots.forEach(img=> { %>
                  <img src="<%= img %>" alt="Screenshot" loading="lazy">
                  <% }) %>
              </div>
            </section>
            <% } %>

              <!-- Rastreador de precios via CheapShark API -->
              <section class="deals-section" style="margin-top: 50px;">
                <div class="deals-header">
                  <h3 class="section-title"><i class="fas fa-tags"></i> Best Deals</h3>
                  <span class="deals-powered">powered by CheapShark</span>
                </div>

                <%/* Recorrer ofertas: muestra tienda, precio de venta y descuento */%>
                <% if (data.deals && data.deals.length > 0) { %>
                  <div class="deals-grid">
                    <% data.deals.forEach(deal => { %>
                      <a href="<%= deal.dealUrl %>" target="_blank" rel="noopener noreferrer" class="deal-card">
                        <div class="deal-store">
                          <img src="<%= deal.storeLogo %>" alt="<%= deal.storeName %>" class="deal-store-logo"
                            onerror="this.style.display='none'">
                          <span class="deal-store-name"><%= deal.storeName %></span>
                        </div>
                        <div class="deal-prices">
                          <% if (deal.isFree) { %>
                            <span class="deal-price-free">FREE</span>
                          <% } else { %>
                            <span class="deal-price-new">$<%= deal.salePrice %></span>
                            <% if (deal.isOnSale && deal.normalPrice !== deal.salePrice) { %>
                              <span class="deal-price-old">$<%= deal.normalPrice %></span>
                            <% } %>
                          <% } %>
                        </div>
                        <% if (deal.isOnSale && deal.savingsPercent > 0) { %>
                          <span class="deal-savings">-<%= deal.savingsPercent %>%</span>
                        <% } %>
                        <span class="deal-go"><i class="fas fa-external-link-alt"></i></span>
                      </a>
                    <% }) %>
                  </div>
                <% } else { %>
                  <div class="deals-empty">
                    <i class="fas fa-store-slash"></i>
                    <p>No deals found for this game right now.</p>
                  </div>
                <% } %>
              </section>

              <!-- Seccion de reviews con formulario y listado -->
              <section style="margin-top: 60px;" id="reviewSection">
                <h3 class="section-title">User Reviews</h3>

                <%/* Si el usuario esta logueado, mostrar formulario de review con sliders */%>
                <% if (user) { %>
                  <div class="review-form-card">
                    <div class="review-header">
                      <img src="<%= data.coverUrl || '/images/no-cover.svg' %>" alt="<%= data.name %> Logo"
                        class="game-logo-small">
                      <span class="review-prompt">What do you think about <strong>
                          <%= data.name %>
                        </strong>?</span>
                    </div>

                    <form id="gameReviewForm" class="review-grid" data-game-id="<%= data.id %>"
                      data-game-name="<%= data.name %>">
                      <div class="rating-sliders">
                        <div class="slider-group">
                          <div class="slider-label"><span>Story</span><span class="slider-value"
                              id="val-story">80</span></div><input type="range" min="0" max="100" value="80"
                            class="range-input" id="input-story" oninput="updateReviewScore()">
                        </div>
                        <div class="slider-group">
                          <div class="slider-label"><span>Gameplay</span><span class="slider-value"
                              id="val-gameplay">75</span></div><input type="range" min="0" max="100" value="75"
                            class="range-input" id="input-gameplay" oninput="updateReviewScore()">
                        </div>
                        <div class="slider-group">
                          <div class="slider-label"><span>Graphics</span><span class="slider-value"
                              id="val-graphics">90</span></div><input type="range" min="0" max="100" value="90"
                            class="range-input" id="input-graphics" oninput="updateReviewScore()">
                        </div>
                        <div class="slider-group">
                          <div class="slider-label"><span>Sound & Music</span><span class="slider-value"
                              id="val-sound">85</span></div><input type="range" min="0" max="100" value="85"
                            class="range-input" id="input-sound" oninput="updateReviewScore()">
                        </div>
                        <div class="total-score-display"><span>Overall Score</span>
                          <div class="big-score-badge good" id="overall-score">83</div>
                        </div>
                      </div>

                      <div class="review-text-area">
                        <textarea id="reviewText" placeholder="Share your experience with this game... (Optional)"
                          rows="8"></textarea>
                        <div class="review-form-footer"
                          style="display:flex; justify-content:space-between; align-items:center; margin-top:15px;">
                          <label class="spoiler-checkbox"
                            style="display:flex; align-items:center; gap:8px; cursor:pointer; color:#ef4444; font-weight:600; font-size:0.9rem; user-select:none;">
                            <input type="checkbox" id="spoilerCheck"
                              style="width:16px; height:16px; accent-color:#ef4444; cursor:pointer;">
                            <span><i class="fas fa-exclamation-triangle"></i> Contains Spoilers</span>
                          </label>
                          <button type="submit" id="submitReviewBtn" class="btn btn-primary">Submit Review</button>
                        </div>
                      </div>
                    </form>
                  </div>
                  <% } else { %>
                    <div class="review-form-card"
                      style="text-align: center; padding: 40px; border: 1px dashed rgba(255,255,255,0.1);">
                      <i class="fas fa-lock" style="font-size: 2rem; color: #8b5cf6; margin-bottom: 15px;"></i>
                      <h4 style="color: #fff; margin-bottom: 10px;">Log in to write a review</h4>
                      <a href="/auth/login" class="btn btn-primary">Sign In / Register</a>
                    </div>
                    <% } %>

                      <!-- Listado de reviews existentes con reacciones y comentarios -->
                      <div class="reviews-list" style="margin-top: 30px;" data-current-uid="<%= user ? (user.uid || user.id || '') : '' %>">
                        <%/* Recorrer cada review con datos del autor, score y contenido */%>
                        <% if (data.reviews && data.reviews.length> 0) { %>
                          <% data.reviews.forEach(review=> { %>
                            <div class="review-card-display" id="review-<%= review.id %>">
                              <div class="review-display-header">
                                <% if (review.userId) { %>
                                  <a href="/profile/u/<%= review.userId %>" class="reviewer-info"
                                    style="text-decoration: none; color: inherit;">
                                    <img src="<%= review.userAvatar || 'https://ui-avatars.com/api/?name=User' %>"
                                      class="reviewer-avatar">
                                    <div>
                                      <span class="reviewer-name">
                                        <%= review.userName || 'Anonymous' %>
                                      </span>
                                      <span class="review-date">
                                        <%= review.createdAt ? new Date(review.createdAt.seconds *
                                          1000).toLocaleDateString() : 'Recently' %>
                                      </span>
                                    </div>
                                  </a>
                                  <% } else { %>
                                    <div class="reviewer-info">
                                      <img src="<%= review.userAvatar || 'https://ui-avatars.com/api/?name=User' %>"
                                        class="reviewer-avatar">
                                      <div>
                                        <span class="reviewer-name">
                                          <%= review.userName || 'Anonymous' %>
                                        </span>
                                        <span class="review-date">
                                          <%= review.createdAt ? new Date(review.createdAt.seconds *
                                            1000).toLocaleDateString() : 'Recently' %>
                                        </span>
                                      </div>
                                    </div>
                                    <% } %>
                                      <div
                                        class="review-score-mini <%= (review.average >= 80) ? 'good' : ((review.average >= 50) ? 'mid' : 'bad') %>">
                                        <%= review.average %>
                                      </div>
                              </div>

                              <%/* Logica de spoilers: ocultar contenido si tiene spoilers y no es el autor */%>
                              <% const isReviewAuthor = user && (user.uid === review.userId || user.id === review.userId); %>
                              <% const showSpoiler = review.hasSpoilers && !isReviewAuthor; %>
                              <div class="review-content <%= showSpoiler ? 'is-spoiler' : '' %>"
                                onclick="this.classList.remove('is-spoiler')">
                                <% if (showSpoiler) { %>
                                  <div class="spoiler-overlay"><i class="fas fa-eye-slash"></i><span>Spoiler Alert!
                                      Click to reveal</span></div>
                                <% } %>
                                <% if (review.hasSpoilers && isReviewAuthor) { %>
                                  <span class="spoiler-author-badge"><i class="fas fa-exclamation-triangle"></i> Spoiler</span>
                                <% } %>
                                    <p>
                                      <%= review.text %>
                                    </p>
                              </div>

                              <%/* Preparar datos de reacciones: conteos, top emojis y reaccion del usuario actual */%>
                              <%
                                const rc = review.reactionCounts || {};
                                const totalReactions = Object.values(rc).reduce((s, v) => s + (v || 0), 0);
                                const emojiMap = { like: '👍', love: '❤️', haha: '😂', wow: '😮', sad: '😢', angry: '😡' };
                                const labelMap = { like: 'Like', love: 'Love', haha: 'Haha', wow: 'Wow', sad: 'Sad', angry: 'Angry' };
                                const topEmojis = Object.entries(rc).filter(([,v]) => v > 0).sort((a,b) => b[1] - a[1]).slice(0, 3).map(([k]) => emojiMap[k]);
                                const userRx = review.userReaction || null;
                                const commentCnt = review.commentCount || 0;
                              %>

                              <!-- Reaction + Comment Interaction -->
                              <div class="review-interactions" data-review-id="<%= review.id %>" data-game-id="<%= data.id %>">

                                <!-- Reaction summary -->
                                <% if (totalReactions > 0 || commentCnt > 0) { %>
                                <div class="reaction-summary-bar">
                                  <% if (totalReactions > 0) { %>
                                  <span class="reaction-summary-left">
                                    <span class="reaction-emoji-icons"><%= topEmojis.join('') %></span>
                                    <span class="reaction-total"><%= totalReactions %></span>
                                  </span>
                                  <% } %>
                                  <% if (commentCnt > 0) { %>
                                  <span class="reaction-summary-right">
                                    <span class="comment-count-summary"><%= commentCnt %> comment<%= commentCnt !== 1 ? 's' : '' %></span>
                                  </span>
                                  <% } %>
                                </div>
                                <% } %>

                                <!-- Action buttons -->
                                <div class="review-action-bar">
                                  <div class="reaction-btn-wrapper">
                                    <button class="btn-react <%= userRx ? 'active reaction-' + userRx : '' %>"
                                      data-current="<%= userRx || '' %>">
                                      <span class="react-emoji"><%= userRx ? emojiMap[userRx] : '👍' %></span>
                                      <span class="react-label"><%= userRx ? labelMap[userRx] : 'Like' %></span>
                                    </button>
                                    <div class="emoji-picker">
                                      <button data-reaction="like" title="Like">👍</button>
                                      <button data-reaction="love" title="Love">❤️</button>
                                      <button data-reaction="haha" title="Haha">😂</button>
                                      <button data-reaction="wow" title="Wow">😮</button>
                                      <button data-reaction="sad" title="Sad">😢</button>
                                      <button data-reaction="angry" title="Angry">😡</button>
                                    </div>
                                  </div>
                                  <button class="btn-comment-toggle">
                                    <i class="far fa-comment"></i>
                                    <span>Comment</span>
                                  </button>
                                </div>

                                <!-- Comments section (hidden by default) -->
                                <div class="review-comments-section" hidden>
                                  <div class="comments-list"></div>
                                  <% if (user) { %>
                                  <div class="comment-input-row">
                                    <img class="comment-avatar-self" src="<%= user.photoURL || user.photoUrl || user.picture || ('https://ui-avatars.com/api/?background=random&color=fff&name=' + (user.displayName || user.username || 'U')) %>" alt="">
                                    <div class="comment-input-wrapper">
                                      <input type="text" class="comment-input" placeholder="Write a comment..." maxlength="1000">
                                      <button class="btn-send-comment" title="Send"><i class="fas fa-paper-plane"></i></button>
                                    </div>
                                  </div>
                                  <% } else { %>
                                  <div class="comment-login-prompt">
                                    <a href="/auth/login">Log in</a> to comment
                                  </div>
                                  <% } %>
                                </div>
                              </div>
                            </div>
                            <% }) %>
                              <% } else { %>
                                <div class="empty-state-review"><i class="far fa-comment-dots"></i>
                                  <p>Be the first to review this game!</p>
                                </div>
                                <% } %>
                      </div>
              </section>
    </div>

    <!-- Sidebar: plataformas disponibles, ano de lanzamiento y desarrollador -->
    <aside class="detail-sidebar">
      <div class="sidebar-card">
        <ul class="info-list">
          <li style="flex-direction: column; align-items: flex-start; gap: 10px;">
            <span class="sidebar-label">Available on</span>
            <% if (data.platforms && data.platforms.length> 0) { %>
              <div class="platform-logos">
                <% data.platforms.forEach(p=> { %>
                  <% const plat=platformMap[p.id]; %>
                    <% if (plat) { %><i class="<%= plat.icon %> platform-icon" title="<%= p.name %>"></i>
                      <% } else { %><span class="platform-text-fallback" title="<%= p.name %>">
                          <%= p.abbreviation || p.name.substring(0,3) %>
                        </span>
                        <% } %>
                          <% }) %>
              </div>
              <% } else { %><span class="text-muted">N/A</span>
                <% } %>
          </li>
          <li><span class="sidebar-label">Release Year</span><span>
              <%= data.year %>
            </span></li>
          <li><span class="sidebar-label">Developer</span><span style="text-align: right;">
              <%= data.companies ? data.companies.split(',')[0] : 'Unknown' %>
            </span></li>
        </ul>
      </div>
    </aside>
  </div>
  </div>

  <!-- Modal para agregar el juego a una coleccion existente o crear una nueva -->
  <div id="collectionModal" class="modal-wrapper">
    <div class="modal-backdrop" onclick="closeCollectionModal()"></div>
    <div class="modal-box">
      <div class="modal-head">
        <h3>Add to Collection</h3>
        <button onclick="closeCollectionModal()" class="btn-close"><i class="fas fa-times"></i></button>
      </div>

      <div class="modal-content">
        <% if (user) { %>

          <div id="collections-list-container" class="list-options">
            <% if (data.userCollections && data.userCollections.length> 0) { %>
              <% data.userCollections.forEach(col=> { %>
                <button onclick="addToCollection('<%= col.id %>')" class="list-btn">
                  <i class="fas fa-folder"></i> <span class="col-title">
                    <%= col.title %>
                  </span>
                </button>
                <% }) %>
                  <% } else { %>
                    <div id="empty-state-msg" class="empty-modal" style="padding: 10px;">
                      <p>No collections yet.</p>
                    </div>
                    <% } %>
          </div>

          <div class="create-collection-mini"
            style="margin-top: 15px; padding-top: 15px; border-top: 1px solid rgba(255,255,255,0.1);">
            <div style="display: flex; gap: 8px;">
              <input type="text" id="newCollectionName" placeholder="New collection name..."
                style="flex:1; background: #111827; border: 1px solid #374151; color: #fff; padding: 10px; border-radius: 6px; outline: none;">
              <button onclick="createCollectionAjax()" class="btn-save"
                style="padding: 0 15px; display: flex; align-items: center; justify-content: center;">
                <i class="fas fa-plus"></i>
              </button>
            </div>
          </div>

          <% } else { %>
            <div class="empty-modal">
              <p>Login to use collections</p>
              <a href="/auth/login" class="btn btn-primary">Login</a>
            </div>
            <% } %>
      </div>
    </div>
  </div>

  <div id="toast-notification" class="toast">
    <i class="fas fa-check-circle toast-icon"></i>
    <span id="toast-message">Success!</span>
  </div>

  <style>
    /* TOAST */
    .toast {
      position: fixed;
      bottom: 30px;
      right: 30px;
      background: #10b981;
      color: white;
      padding: 16px 24px;
      border-radius: 12px;
      display: flex;
      align-items: center;
      gap: 12px;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
      font-weight: 600;
      z-index: 100001;
      transform: translateY(100px);
      opacity: 0;
      transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }

    .toast.show {
      transform: translateY(0);
      opacity: 1;
    }

    .toast.error {
      background: #ef4444;
    }

    .toast-icon {
      font-size: 1.2rem;
    }

    /* MODAL */
    .modal-wrapper {
      display: none;
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      z-index: 99999;
      justify-content: center;
      align-items: center;
    }

    .modal-wrapper.show {
      display: flex !important;
    }

    .modal-backdrop {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(0, 0, 0, 0.8);
      backdrop-filter: blur(4px);
    }

    .modal-box {
      position: relative;
      background: #1f2937;
      width: 90%;
      max-width: 400px;
      border-radius: 12px;
      border: 1px solid rgba(255, 255, 255, 0.1);
      box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
      z-index: 100000;
      overflow: hidden;
      animation: modalPop 0.3s ease-out;
    }

    @keyframes modalPop {
      from {
        transform: scale(0.95);
        opacity: 0;
      }

      to {
        transform: scale(1);
        opacity: 1;
      }
    }

    .modal-head {
      padding: 20px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .modal-head h3 {
      margin: 0;
      color: #fff;
      font-size: 1.2rem;
    }

    .btn-close {
