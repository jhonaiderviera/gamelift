<link rel="stylesheet" href="/stylesheets/support.css">

<div class="support-hero">
  <div class="container" style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; padding-top: 40px;">
    <div style="max-width: 600px;">
      <span class="hero-tag">Indie Community</span>
      <h1 style="font-size: 3rem; font-weight: 800; line-height: 1.1; margin: 15px 0; color: #fff;">
        Support <span style="background: linear-gradient(90deg, #a78bfa 0%, #f472b6 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">Indie Creativity</span>
      </h1>
      <p style="color: #9ca3af; font-size: 1.1rem; line-height: 1.6;">
        Discover unique projects from our community. Donate directly to developers to help them bring their dreams to life.
      </p>
    </div>

    <div style="margin-top: 20px;">
      <% if (user) { %>
        <a href="/support-developers/create" class="btn-donate" style="text-decoration: none; display: inline-flex; width: auto; background: var(--primary); color: white; padding: 12px 24px; font-size: 1rem;">
          <i class="fas fa-rocket"></i> Launch Project
        </a>
      <% } else { %>
        <a href="/auth/login" class="btn-donate" style="text-decoration: none; display: inline-flex; width: auto; background: rgba(255,255,255,0.1); color: #fff;">
          Log in to Create
        </a>
      <% } %>
    </div>
  </div>
</div>

<div class="container" style="padding-bottom: 80px;">

  <% if (messages && messages.success) { %>
    <div class="alert alert-success" style="margin-bottom: 30px; padding: 15px; background: rgba(16,185,129,0.2); border: 1px solid rgba(16,185,129,0.3); border-radius: 12px; color: #6ee7b7; display: flex; align-items: center; gap: 12px; animation: fadeIn 0.5s ease;">
      <i class="fas fa-check-circle" style="font-size: 1.2rem;"></i> 
      <span style="font-weight: 500;"><%= messages.success %></span>
    </div>
  <% } %>

  <% if (messages && messages.error) { %>
    <div class="alert alert-error" style="margin-bottom: 30px; padding: 15px; background: rgba(239,68,68,0.2); border: 1px solid rgba(239,68,68,0.3); border-radius: 12px; color: #fca5a5; display: flex; align-items: center; gap: 12px; animation: fadeIn 0.5s ease;">
      <i class="fas fa-exclamation-circle" style="font-size: 1.2rem;"></i> 
      <span style="font-weight: 500;"><%= messages.error %></span>
    </div>
  <% } %>
  <div class="projects-grid">
    <% if (data.projects && data.projects.length > 0) { %>
      <% data.projects.forEach(project => { %>
        
        <article class="project-card">
          
          <a href="/support-developers/<%= project.id %>" class="card-link-wrapper">
            <div class="project-media">
              <img src="<%= project.image %>" alt="<%= project.title %>" loading="lazy">
              
              <div class="category-badges">
                <% if(project.tags && project.tags.length > 0) { %>
                  <% project.tags.slice(0, 2).forEach(tag => { %>
                    <span class="badge"><%= tag %></span>
                  <% }) %>
                <% } else { %>
                  <span class="badge">Indie</span>
                <% } %>
              </div>
            </div>
          </a>

          <div class="project-body">
            
            <a href="/profile/u/<%= project.authorId %>" style="text-decoration: none; width: fit-content;">
              <div class="project-author">
                <img 
                  src="<%= (project.authorAvatar && project.authorAvatar.startsWith('http')) ? project.authorAvatar : 'https://ui-avatars.com/api/?name=' + (project.author || 'User') + '&background=random&color=fff' %>" 
                  alt="Author"
                >
                <span><%= project.author || 'Anonymous' %></span>
              </div>
            </a>

            <a href="/support-developers/<%= project.id %>" class="card-link-wrapper">
              <h3 class="project-title"><%= project.title %></h3>
            </a>

            <p class="project-desc">
              <%= (project.desc || "").substring(0, 100) %><%= (project.desc && project.desc.length > 100) ? '...' : '' %>
            </p>

            <% 
              const goal = project.goal || 1; 
              const raised = project.raised || 0;
              const percent = Math.min(100, Math.round((raised / goal) * 100));
            %>
            
            <div class="funding-section">
              <div class="funding-info">
                <span class="raised">$<%= raised.toLocaleString() %> <small>of $<%= goal.toLocaleString() %></small></span>
                <span class="percent"><%= percent %>%</span>
              </div>
              <div class="progress-bar-track">
                <div class="progress-bar-fill" style="width: <%= percent %>%;"></div>
              </div>
              <div style="font-size: 0.8rem; color: #6b7280; margin-top: 8px; display: flex; align-items: center; gap: 5px;">
                <i class="fas fa-users" style="font-size: 0.75rem;"></i> <%= project.backers || 0 %> backers
              </div>
            </div>

            <div style="display: flex; gap: 10px; margin-top: auto;">
              <a href="/support-developers/<%= project.id %>" class="btn-donate" style="background: rgba(255,255,255,0.05); color: #fff; flex: 1;">
                Details
              </a>
              
              <% if (user) { %>
                <button class="btn-donate" onclick="openDonationModal('<%= project.id %>', '<%= project.title %>')" style="flex: 1;">
                  <i class="fas fa-heart"></i> Support
                </button>
              <% } else { %>
                <a href="/auth/login" class="btn-donate" style="flex: 1;">Login</a>
              <% } %>
            </div>

          </div>
        </article>

      <% }) %>
    <% } else { %>
      <div class="state-container" style="grid-column: 1 / -1; text-align: center; padding: 80px; background: rgba(255,255,255,0.03); border-radius: 20px; border: 1px dashed rgba(255,255,255,0.1);">
        <i class="fas fa-gamepad" style="font-size: 3rem; color: #4b5563; margin-bottom: 20px;"></i>
        <h3 style="color: #fff; margin-bottom: 10px;">No projects yet</h3>
        <p style="color: #9ca3af; margin-bottom: 25px;">Be the first developer to launch an indie game campaign!</p>
        <% if (user) { %>
          <a href="/support-developers/create" class="btn-donate" style="background: var(--primary); color: white; display: inline-block; width: auto; padding: 10px 25px;">Start Campaign</a>
        <% } %>
      </div>
    <% } %>
  </div>

</div>

<div id="donationModal" class="modal-overlay">
  <div class="donation-card">
    <div class="modal-header">
      <div>
        <h3 id="modalProjectTitle">Support Project</h3>
        <p style="font-size:0.9rem; color:#9ca3af; margin:0;">Make a difference today</p>
      </div>
      <button onclick="closeDonationModal()" class="close-modal-btn"><i class="fas fa-times"></i></button>
    </div>

    <form id="donationForm" action="" method="POST">
      <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>" />

      <label class="donation-label">Select Amount</label>
      <div class="amount-grid">
        <div class="amount-option" onclick="selectAmount(5, this)">$5</div>
        <div class="amount-option active" onclick="selectAmount(15, this)">$15</div> 
        <div class="amount-option" onclick="selectAmount(50, this)">$50</div>
        <div class="amount-input-wrapper">
          <span>$</span>
          <input type="number" id="customAmount" placeholder="Other" oninput="selectCustomAmount(this)">
        </div>
      </div>

      <input type="hidden" name="amount" id="finalAmount" value="15">

      <label class="donation-label" style="margin-top: 20px;">Payment Method</label>
      <div class="payment-methods">
        <div class="payment-option active"><i class="fab fa-cc-visa"></i> Card</div>
        <div class="payment-option"><i class="fab fa-paypal"></i> PayPal</div>
        <div class="payment-option"><i class="fab fa-google-pay"></i> Pay</div>
      </div>

      <button type="submit" class="btn-confirm-donation">
        Donate Now <i class="fas fa-arrow-right"></i>
      </button>
      
      <p class="secure-text"><i class="fas fa-lock"></i> Secure SSL Encrypted Transaction (Simulation)</p>
    </form>
  </div>
</div>

<script>
  const modal = document.getElementById('donationModal');
  const form = document.getElementById('donationForm');
  const title = document.getElementById('modalProjectTitle');
  const amountInput = document.getElementById('finalAmount');
  const customInput = document.getElementById('customAmount');

  // Abrir Modal
  function openDonationModal(id, projectName) {
    form.action = `/support-developers/donate/${id}`;
    title.innerText = `Support "${projectName}"`;
    modal.classList.add('visible');
  }

  // Cerrar Modal
  function closeDonationModal() {
    modal.classList.remove('visible');
  }

  // Cerrar al hacer clic fuera
  modal.addEventListener('click', (e) => {
    if (e.target === modal) closeDonationModal();
  });

  // Selección de botones ($5, $15...)
  function selectAmount(val, element) {
    amountInput.value = val;
    customInput.value = ''; 
    document.querySelectorAll('.amount-option').forEach(el => el.classList.remove('active'));
    document.querySelectorAll('.amount-input-wrapper').forEach(el => el.classList.remove('active'));
    element.classList.add('active');
  }

  // Escribir cantidad personalizada
  function selectCustomAmount(input) {
    amountInput.value = input.value;
    document.querySelectorAll('.amount-option').forEach(el => el.classList.remove('active'));
    input.parentElement.classList.add('active');
  }

  // Efecto visual en métodos de pago
  document.querySelectorAll('.payment-option').forEach(opt => {
    opt.addEventListener('click', () => {
      document.querySelectorAll('.payment-option').forEach(el => el.classList.remove('active'));
      opt.classList.add('active');
    });
  });
</script>